# AWS (coordinator side; standard AWS credential chain is used — no keys here)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
# ARN printed by `agentcore deploy`; used by evaluations/invoke_hosted.py
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:REPLACE:REPLACE:runtime/REPLACE

# A2A peer selection: adk (Google ADK on Cloud Run) or foundry (Microsoft Foundry)
CURRENCY_A2A_PEER=adk

# Remote Google ADK agent (anonymous)
CURRENCY_A2A_ENDPOINT=https://REPLACE
ADK_A2A_AGENT_CARD_URL=https://REPLACE/.well-known/agent-card.json

# Remote Microsoft Foundry agent (Entra-authenticated; card at agentCard/v1.0)
CURRENCY_FOUNDRY_A2A_ENDPOINT=https://REPLACE.services.ai.azure.com/api/projects/REPLACE/agents/currency-a2a-agent/endpoint/protocols/a2a
FOUNDRY_PROJECT_ENDPOINT=https://REPLACE.services.ai.azure.com/api/projects/REPLACE
FOUNDRY_AGENT_NAME=currency-a2a-agent
# AWS Secrets Manager id holding {tenant_id, client_id, client_secret}.
# The coordinator has no Azure identity; never put the secret itself here.
CURRENCY_AZURE_SECRET_ID=bedrock-foundry-a2a/azure-service-principal

# Remote Bedrock AgentCore peer when Foundry is the coordinator. Configure the
# runtime with a custom JWT authorizer; never commit the client secret.
CURRENCY_BEDROCK_A2A_ENDPOINT=https://REPLACE
CURRENCY_BEDROCK_OAUTH_TOKEN_URL=https://REPLACE/oauth2/token
CURRENCY_BEDROCK_OAUTH_CLIENT_ID=REPLACE
CURRENCY_BEDROCK_OAUTH_CLIENT_SECRET=REPLACE
CURRENCY_BEDROCK_OAUTH_SCOPE=currencybench/invoke
CURRENCY_TIMEOUT_SECONDS=60

# MCP exchange-rate server
EXCHANGE_MCP_URL=https://REPLACE/mcp

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=bedrock-foundry-a2a-currency
